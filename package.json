{
  "name": "makers-prueba-tecnica",
  "version": "1.0.0",
  "private": true,
  "description": "Prueba tecnica QA Makers: smoke test SauceDemo (Cypress) + pruebas funcionales MakersPay + pruebas API reqres.in",
  "scripts": {
    "cy:open": "cypress open --project automation",
    "test:login": "cypress run --project automation --spec cypress/e2e/login.cy.js",
    "test:api": "jest --config api/jest.config.js",
    "test:api:postman": "newman run api/postman/MakersPay-API.postman_collection.json --reporters cli,htmlextra --reporter-htmlextra-export api/evidence/postman-report.html"
  },
  "devDependencies": {
    "cypress": "^15.0.0",
    "jest": "^29.7.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
